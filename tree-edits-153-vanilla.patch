+            guard let raw = readFileText(url) else { continue }
+            let text = String(raw.prefix(perItemCap))
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !text.isEmpty else { continue }
+            add("File — \(url.lastPathComponent):\n\(text)\n\n")
+        }
+        return parts.joined()
+    }
