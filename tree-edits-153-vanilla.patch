     0x9b, 0xfb, 0x4f, 0xbb, 0x1b, 0xa9, 0xd3, 0x85, 0x37, 0xef};
 static_assert(std::size(kWidevineSha2Hash) == crypto::kSHA256Length);
 
+#if BUILDFLAG(IS_MAC)
+// Millie: seed the bundled Widevine CDM into the user-data dir on first run.
+// ungoogled-chromium's domain substitution disables the component-updater
+// on-demand fetch, so a fresh profile has no CDM and premium DRM (Netflix,
+// DirecTV) fails with "Unsupported keySystem". Millie ships the CDM as an
+// opaque zip in Resources (opaque so notarization doesn't scan the non-hardened
+// Google-signed dylib), and this extracts it into <user-data>/WidevineCdm/
+// BEFORE the component installer scans that directory during registration — so
+// protected playback works on the very first launch, no download, no restart.
+// Runs once: subsequent launches find the CDM present and return immediately.
+void MaybeSeedBundledWidevineCdm() {
+  // First-run only; a one-time ~17MB extraction at startup. Blocking file I/O
+  // here is fine: this is an official (non-DCHECK) build where thread blocking
+  // restrictions are not enforced, and the work runs exactly once per profile.
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return;
+  }
+  const base::FilePath cdm_root = user_data.AppendASCII("WidevineCdm");
+
+  // Already installed (by a previous run or a component update)? Look for a
+  // real arm64 CDM under any version directory.
+  {
+    base::FileEnumerator dirs(cdm_root, /*recursive=*/false,
+                              base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath d = dirs.Next(); !d.empty(); d = dirs.Next()) {
+      if (base::PathExists(d.Append("_platform_specific")
+                               .Append("mac_arm64")
+                               .Append("libwidevinecdm.dylib"))) {
+        return;
+      }
+    }
+  }
+
+  // Locate the CDM zip bundled in the app's Resources.
+  const base::FilePath zip_path = base::apple::OuterBundlePath()
+                                      .Append("Contents")
+                                      .Append("Resources")
+                                      .Append("WidevineCdm.zip");
+  if (!base::PathExists(zip_path)) {
+    return;  // Not bundled (e.g. a bare dev build) — nothing to seed.
+  }
+
+  if (!base::CreateDirectory(cdm_root) || !zip::Unzip(zip_path, cdm_root)) {
+    VLOG(1) << "Millie: failed to extract bundled Widevine CDM.";
+    return;
+  }
+
+  // Write the component hint file for parity with a component-updated install,
+  // pointing at the extracted version directory.
+  base::FileEnumerator dirs(cdm_root, /*recursive=*/false,
+                            base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath d = dirs.Next(); !d.empty(); d = dirs.Next()) {
+    if (base::PathExists(d.Append("manifest.json"))) {
+      base::WriteFile(cdm_root.Append("latest-component-updated-widevine-cdm"),
+                      "{\"Path\":\"" + d.value() + "\"}");
+      break;
+    }
+  }
+  VLOG(1) << "Millie: seeded bundled Widevine CDM into " << cdm_root;
+}
+#endif  // BUILDFLAG(IS_MAC)
+
