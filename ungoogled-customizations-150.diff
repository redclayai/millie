+++ b/patches/extra/ungoogled-chromium/prepopulated-search-engines.patch
@@ -1,13 +1,9 @@
-# Disables Site search Starter Pack
+# No-op: `kStarterPackExpansion` is what registers YouTube / Amazon /
+# Wikipedia / etc. as Tab-to-Search keyword-search providers. Disabling
+# this made the omnibox suggestion still show "Search YouTube · Tab" via
+# history/autocomplete, but the actual keyword provider was gone, so
+# Tab was a no-op. Keeping Chromium's default (enabled on non-iOS).
+#
+# If you need to hide Google's built-in AI shortcuts (@gemini / @aimode
+# / @page), those are already gated in disable-ai-search-shortcuts.patch.
 #
---- a/components/omnibox/common/omnibox_features.cc
-+++ b/components/omnibox/common/omnibox_features.cc
-@@ -286,7 +286,7 @@ BASE_FEATURE(kOmniboxTouchDownTriggerFor
- BASE_FEATURE(kOmniboxSiteSearch, DISABLED);
- 
- // Enables additional site search providers for the Site search Starter Pack.
--BASE_FEATURE(kStarterPackExpansion, enable_if(!IS_IOS));
-+BASE_FEATURE(kStarterPackExpansion, base::FEATURE_DISABLED_BY_DEFAULT);
- 
