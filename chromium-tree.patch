+++ b/chrome/app/chrome_main_delegate.cc
@@ -1055,6 +1055,31 @@
 }
 
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+  // Millie: bake in the switches required for premium DRM streaming so they
+  // apply on a normal (Dock) launch without being passed manually.
+  //  - PlatformHEVCDecoderSupport: HEVC is compiled in but gated off at runtime.
+  //  - disable-gpu-compositing: Millie's non-Views window cannot present the
+  //    hardware video-overlay CALayer that protected (EME) video is promoted to,
+  //    so DRM video renders blank under GPU compositing; software compositing
+  //    routes it through the surface Millie does present.
+  // Appended here (the earliest delegate hook) so it lands before FeatureList
+  // and GPU initialization.
+  {
+    base::CommandLine* mori_cmd = base::CommandLine::ForCurrentProcess();
+    if (!mori_cmd->HasSwitch("disable-gpu-compositing")) {
+      mori_cmd->AppendSwitch("disable-gpu-compositing");
+    }
+    std::string mori_features =
+        mori_cmd->GetSwitchValueASCII("enable-features");
+    if (mori_features.find("PlatformHEVCDecoderSupport") ==
+        std::string::npos) {
+      mori_cmd->AppendSwitchASCII(
+          "enable-features",
+          mori_features.empty()
+              ? "PlatformHEVCDecoderSupport"
+              : mori_features + ",PlatformHEVCDecoderSupport");
+    }
+  }
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
